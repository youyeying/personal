# =====================================================
# 个人记录系统 - 后端配置模板
# 使用方式：
#   1. 将本文件复制为 application.properties
#   2. 修改「数据源」中的数据库账号密码、按需修改 JWT 密钥
# 注意：仓库中不包含 application.properties（含本地敏感信息），
#       请勿将 application.properties 提交到 GitHub（已 .gitignore）
# =====================================================

# ===================== 应用 =====================
spring.application.name=personal-record-backend
server.port=8080

# ===================== 数据源（改成你自己的 MySQL） =====================
spring.datasource.url=jdbc:mysql://localhost:3306/personal_record?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=你的_mysql_用户名
spring.datasource.password=你的_mysql_密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===================== MyBatis-Plus =====================
# 实体别名包（支持注解扫描）
mybatis-plus.type-aliases-package=com.personal.backend.entity
# 下划线转驼峰
mybatis-plus.configuration.map-underscore-to-camel-case=true
# 逻辑删除配置（deleted 字段：0 未删 / 1 已删）
mybatis-plus.global-config.db-config.logic-delete-field=deleted
mybatis-plus.global-config.db-config.logic-delete-value=1
mybatis-plus.global-config.db-config.logic-not-delete-value=0

# ===================== 认证（JWT access + Refresh 会话） =====================
# 生产环境务必更换密钥（任意足够长的随机字符串）
app.jwt.secret=换成你自己的_jwt_secret_随机长字符串
# accessToken 有效期（分钟）：公开系统建议 15 分钟
app.jwt.expire-minutes=15

# refresh Token 会话有效期（小时）：滚动续期，每次刷新重置为当前时间 + 24h
app.session.expire-hours=24
# refresh Cookie 是否 Secure（生产 HTTPS 设为 true，本地 http 保持 false）
app.session.cookie-secure=false

# ===================== 文件上传 =====================
# 本地存储根目录（相对于项目运行目录）
app.upload-path=./uploads

# multipart 单文件/总请求上限：需 ≥ 业务上限（头像≤2MB、学习附件≤10MB）
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ===================== 日志 =====================
logging.level.com.personal.backend=debug